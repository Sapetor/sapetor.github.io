<header class="hero">
  <div class="hero-text">
    <h1 class="hero-name">
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}
    </h1>
    <p class="hero-role">
      {{ page.hero_role -}}
      <br>
      {{ page.hero_affiliation }}
    </p>
    <p class="hero-statement">{{ page.hero_statement }}</p>
    <nav class="hero-links" aria-label="Primary links">
      <a class="hero-link hero-link-primary" href="{{ '/publications/' | relative_url }}">Publications</a>
      <a class="hero-link" href="{{ '/cv/' | relative_url }}">CV</a>
      <a class="hero-link" href="mailto:{{ site.email | encode_email }}">Email</a>
    </nav>
  </div>
  {% if page.profile.image %}
    <div class="hero-photo">
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {%
        include figure.liquid loading="eager" path=profile_image_path class="img-fluid rounded" sizes="(min-width: 768px) 240px, 60vw" alt=page.profile.alt_text
        cache_bust=true
      %}
    </div>
  {% endif %}
</header>

<figure class="platoon-figure">
  <canvas
    id="platoon-strip"
    role="img"
    aria-label="Animation of eight vehicles in a platoon. When the leading vehicle slows down, each follower brakes less than the vehicle ahead of it."
  ></canvas>
  <figcaption>
    A simulated predecessor-following platoon with a constant time-headway policy. The bar above each vehicle is its deviation from cruising speed,
    and the tick marks its largest speed drop during the current slow-down. When the leader (right) slows down, each follower slows down less than the
    vehicle ahead, so the disturbance shrinks along the string. This property is called string stability.
    <a href="{{ '/platoon/' | relative_url }}">Open the interactive simulator</a>
  </figcaption>
</figure>
<script src="{{ '/assets/js/platoon_strip.js' | relative_url }}" defer></script>
