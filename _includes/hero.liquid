<header class="hero">
  <div class="hero-text">
    <h1 class="hero-name">
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}
    </h1>
    <p class="hero-role">
      {{ page.hero_role -}}
      <br>
      {{ page.hero_affiliation }}
    </p>
    <p class="hero-statement">{{ page.hero_statement }}</p>
    <nav class="hero-links" aria-label="Primary links">
      <a class="hero-link hero-link-primary" href="{{ '/publications/' | relative_url }}">Publications</a>
      <a class="hero-link" href="{{ '/cv/' | relative_url }}">CV</a>
      <a class="hero-link" href="mailto:{{ site.email | encode_email }}">Email</a>
    </nav>
  </div>
  {% if page.profile.image %}
    <div class="hero-photo">
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {%
        include figure.liquid loading="eager" path=profile_image_path class="img-fluid rounded" sizes="(min-width: 768px) 240px, 60vw" alt=page.profile.alt_text
        cache_bust=true
      %}
    </div>
  {% endif %}
</header>
